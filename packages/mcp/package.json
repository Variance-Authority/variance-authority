{
  "name": "@variance-authority/mcp",
  "version": "0.0.0-beta.1",
  "description": "Expose a completed visual run and its source-to-test selection to an MCP client.",
  "keywords": [
    "visual-regression",
    "visual-testing",
    "variance-authority",
    "mcp",
    "agent",
    "model-context-protocol",
    "ai"
  ],
  "license": "MIT",
  "author": "Mechanic Garden",
  "homepage": "https://variance-authority.dev#packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "variance-authority-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/report": "workspace:^",
    "@variance-authority/sense": "workspace:^"
  },
  "devDependencies": {
    "@variance-authority/core": "workspace:^"
  }
}
