{
  "name": "variance-authority",
  "description": "Visual Regression. Verifiable Results.",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "cases/*"
  ],
  "scripts": {
    "build": "tsc --build && node tools/page-agents.mjs && node tools/tribunal-ui.mjs && node tools/tribunal-migrations.mjs",
    "check": "vitest run --config vitest.checks.config.ts",
    "clean": "tsc --build --clean",
    "lint": "oxlint",
    "measure": "vitest run --config vitest.measure.config.ts",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "test": "vitest run",
    "test:since": "node tools/test-since.mjs",
    "test:watch": "vitest",
    "unrun": "node tools/unrun.mjs",
    "surface": "node tools/surface.mjs",
    "documented": "node tools/documented.mjs",
    "typecheck": "tsc --build --force",
    "verify": "yarn lint && yarn check && yarn measure && yarn test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "backlog.md": "1.50.1",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "oxc-parser": "^0.144.0",
    "oxlint": "^1.77.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
