{
  "project": "example-history",
  "profile": "chromium",
  "viewport": {
    "width": 900,
    "height": 500
  },
  "retention": "durable",
  "subjects": {
    "kind": "list",
    "ids": [
      "billing"
    ],
    "collector": "variance/routes.mjs"
  },
  "baselines": {
    "kind": "directory",
    "root": ".variance/baselines"
  },
  "history": {
    "endpoint": "http://localhost:7788",
    "token": {
      "env": "VARIANCE_HISTORY_TOKEN"
    }
  },
  "fonts": [],
  "report": "out/report.json"
}
