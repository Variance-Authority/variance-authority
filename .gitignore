.idea
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*

# Build output
dist
*.tsbuildinfo
docs-examples

# The prebuilt scanner, per platform package — one binary for the floor of the
# platform and, where there is one, a second for a newer machine. The manifests
# beside them are the published thing and are tracked; the binaries are produced
# by `native/build.mjs` on a machine or a release runner, and a copy in git would
# be a fourth answer to which bytes ship.
packages/sense/npm/*/*.node

# The two copies of `dist` the probe-overhead benchmark compares. Inside the
# package because a bare specifier only resolves from somewhere `node_modules` is
# reachable, and removed in a `finally` — this catches an interrupted run.
packages/sense/.overhead-*

# Test + capture artifacts
.variance/
# The seam's setup shim, written per run and named by pid and uuid: a file
# a run makes for itself and no later run can use.
.variance-authority/
coverage/
packages/react/browser-check/www/bundle.js

# Agent worktrees
.claude/worktrees/
docker/results/
storybook-static/

# The incumbent's own artifacts: its baselines are this machine's Chromium, and
# its report belongs to a run rather than to the repository. Regenerate with
# `yarn workspace @variance-authority/case-incumbent incumbent`.
cases/*/incumbent/
cases/*/test-results/

# The second Storybook build, produced with VITE_CASE_MUTATION set. Derived, and
# regenerated by `build-storybook:changed`.
cases/*/storybook-changed/

# The third: the same stories with `@storybook/addon-a11y` installed, which one
# suite reads and no other may. Regenerated by `build-storybook:a11y`.
cases/*/storybook-a11y/

# The built editor plugins `@variance-authority/editors` carries. They are built
# from `editors/` by `packages/editors/scripts/build.mjs`, on a machine or the
# release runner, and a tracked copy would be a second answer to which bytes ship.
packages/editors/variance-authority.vsix
packages/editors/variance-authority.jar
