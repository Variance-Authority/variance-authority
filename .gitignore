.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Whether you use PnP or not, the node_modules folder is often used to store
# build artifacts that should be gitignored
node_modules

# Swap the comments on the following lines if you wish to use zero-installs
# In that case, don't forget to run `yarn config set enableGlobalCache false`!
# Documentation here: https://yarnpkg.com/features/caching#zero-installs

#!.yarn/cache
.pnp.*

# Build output
dist
*.tsbuildinfo

# The two copies of `dist` the probe-overhead benchmark compares. Inside the
# package because a bare specifier only resolves from somewhere `node_modules` is
# reachable, and removed in a `finally` — this catches an interrupted run.
packages/oxc/.overhead-*

# Test + capture artifacts
.variance/
coverage/
packages/provenance-react/browser-check/www/bundle.js

# Agent worktrees
.claude/worktrees/
docker/results/
storybook-static/

# The incumbent's own artifacts: its baselines are this machine's Chromium, and
# its report belongs to a run rather than to the repository. Regenerate with
# `yarn workspace @variance-authority/case-incumbent incumbent`.
cases/*/incumbent/
cases/*/test-results/

# The second Storybook build, produced with VITE_CASE_MUTATION set. Derived, and
# regenerated by `build-storybook:changed`.
cases/*/storybook-changed/
