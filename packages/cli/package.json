{
  "name": "@variance-authority/cli",
  "version": "0.2.0",
  "description": "Run the Variance Authority workflow from a project config: collect subjects, compare, render what moved, report, accept.",
  "keywords": [
    "variance-authority",
    "visual-regression",
    "visual-testing",
    "screenshot-testing",
    "visual-diff",
    "ci"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22.15"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": "./schema/variance.config.schema.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "variance": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg",
    "schema",
    "skill"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/distill": "workspace:^",
    "@variance-authority/eyes": "workspace:^",
    "@variance-authority/history": "workspace:^",
    "@variance-authority/mcp": "workspace:^",
    "@variance-authority/observe": "workspace:^",
    "@variance-authority/playwright": "workspace:^",
    "@variance-authority/png": "workspace:^",
    "@variance-authority/png-sharp": "workspace:^",
    "@variance-authority/raster": "workspace:^",
    "@variance-authority/remote": "workspace:^",
    "@variance-authority/report": "workspace:^",
    "@variance-authority/sense": "workspace:^",
    "@variance-authority/store": "workspace:^",
    "@variance-authority/storybook": "workspace:^",
    "@variance-authority/vantage": "workspace:^"
  }
}
