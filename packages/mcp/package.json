{
  "name": "@variance-authority/mcp",
  "version": "0.5.9",
  "description": "Expose independently supplied observability evidence to an MCP client.",
  "keywords": [
    "variance-authority",
    "visual-regression",
    "mcp",
    "model-context-protocol",
    "agent",
    "ai"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/mcp"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22.15"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "variance-authority-mcp": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/distill": "workspace:^",
    "@variance-authority/eyes": "workspace:^",
    "@variance-authority/presentation": "workspace:^",
    "@variance-authority/report": "workspace:^",
    "@variance-authority/scenario": "workspace:^",
    "@variance-authority/sense": "workspace:^",
    "@variance-authority/vantage": "workspace:^"
  }
}
