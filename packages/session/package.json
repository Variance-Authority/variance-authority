{
  "name": "@variance-authority/session",
  "version": "0.5.4",
  "description": "Run many Variance Authority subjects in one standing DOM world, and detect cross-pollution rather than prevent it.",
  "keywords": [
    "variance-authority",
    "dom",
    "isolation",
    "mount",
    "performance"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/session",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/session"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/dom": "workspace:^"
  },
  "devDependencies": {
    "@variance-authority/react": "workspace:^",
    "jsdom": "^30.0.1",
    "react": "^19",
    "react-dom": "^19"
  }
}
