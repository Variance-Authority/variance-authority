{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.measure.ts",
    "src/__fixtures__/**"
  ],
  "references": [
    {
      "path": "../package"
    },
    {
      "path": "../mcp"
    },
    {
      "path": "../sense"
    }
  ]
}
