{
  "name": "@variance-authority/sense",
  "version": "0.14.0",
  "description": "Which components and tests a source change reaches: test selection and impact analysis from a versioned index of a checkout.",
  "keywords": [
    "variance-authority",
    "test-selection",
    "impact-analysis",
    "dependency-graph",
    "static-analysis",
    "monorepo",
    "typescript"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/sense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/sense"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22.15"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./read": {
      "types": "./dist/read.d.ts",
      "default": "./dist/read.js"
    },
    "./lock": {
      "types": "./dist/lock/index.d.ts",
      "default": "./dist/lock/index.js"
    },
    "./taint": {
      "types": "./dist/taint/index.d.ts",
      "default": "./dist/taint/index.js"
    },
    "./instrument": {
      "types": "./dist/instrument/index.d.ts",
      "default": "./dist/instrument/index.js"
    },
    "./test-selection": {
      "types": "./dist/test-selection/index.d.ts",
      "default": "./dist/test-selection/index.js"
    },
    "./cache-root": {
      "types": "./dist/test-selection/cache-root.d.ts",
      "default": "./dist/test-selection/cache-root.js"
    },
    "./journal": {
      "types": "./dist/test-selection/journal.d.ts",
      "default": "./dist/test-selection/journal.js"
    },
    "./journey": {
      "types": "./dist/test-selection/journey.d.ts",
      "default": "./dist/test-selection/journey.js"
    },
    "./precondition": {
      "types": "./dist/test-selection/precondition.d.ts",
      "default": "./dist/test-selection/precondition.js"
    },
    "./story": {
      "types": "./dist/story/index.d.ts",
      "default": "./dist/story/index.js"
    },
    "./vitest": {
      "types": "./dist/test-selection/vitest.d.ts",
      "default": "./dist/test-selection/vitest.js"
    },
    "./rstest": {
      "types": "./dist/test-selection/rstest.d.ts",
      "default": "./dist/test-selection/rstest.js"
    },
    "./rstest-loader": {
      "types": "./dist/test-selection/rstest-loader.d.ts",
      "default": "./dist/test-selection/rstest-loader.js"
    },
    "./jest": {
      "types": "./dist/test-selection/jest.d.ts",
      "default": "./dist/test-selection/jest.js"
    },
    "./jest-transform": {
      "types": "./dist/test-selection/jest-transform.d.ts",
      "default": "./dist/test-selection/jest-transform.js"
    },
    "./jest-reporter": {
      "types": "./dist/test-selection/jest-reporter.d.ts",
      "default": "./dist/test-selection/jest-reporter.js"
    },
    "./runner": {
      "types": "./dist/test-selection/runner.d.ts",
      "default": "./dist/test-selection/runner.js"
    },
    "./jest-setup": "./dist/test-selection/jest-setup.cjs",
    "./jest-globals": "./dist/test-selection/jest-globals.cjs",
    "./case-journey": "./dist/test-selection/case-journey.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!dist/native",
    "mark.svg",
    "native/instrument/Cargo.toml",
    "native/instrument/build.rs",
    "native/instrument/src/*.rs",
    "scripts/overhead.mjs",
    "scripts/probe-write.mjs"
  ],
  "scripts": {
    "build": "tsc --build && node native/build.mjs",
    "test:native": "cargo test --manifest-path native/Cargo.toml --workspace --lib --locked && node native/consumer.mjs",
    "storage": "node scripts/storage.mjs",
    "overhead": "node scripts/overhead.mjs",
    "probe-write": "node scripts/probe-write.mjs",
    "coverage": "node scripts/coverage.mjs",
    "native": "node scripts/native.mjs",
    "round-trip": "node scripts/round-trip.mjs"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/wire": "workspace:^",
    "oxc-parser": "^0.144.0",
    "oxc-resolver": "^11.24.2",
    "picomatch": "^4.0.7"
  },
  "optionalDependencies": {
    "@variance-authority/sense-darwin-arm64": "workspace:*",
    "@variance-authority/sense-linux-arm64-gnu": "workspace:*",
    "@variance-authority/sense-linux-x64-gnu": "workspace:*",
    "@variance-authority/sense-win32-x64-msvc": "workspace:*"
  },
  "peerDependencies": {
    "@jest/globals": "^30.0.0",
    "jest": "^30.0.0",
    "jest-circus": "^30.0.0",
    "vitest": "^2.1.9 || ^3.0.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@jest/globals": {
      "optional": true
    },
    "jest": {
      "optional": true
    },
    "jest-circus": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@rstest/core": "^0.12.0",
    "@sentry/node": "^11.0.0",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/picomatch": "^4.0.3",
    "jest": "^30.5.1",
    "vite": "^6.0.0"
  }
}
