{
  "project": "storybook-case",
  "profile": "chromium",
  "viewport": { "width": 1024, "height": 768, "deviceScaleFactor": 1, "colorScheme": "light" },
  "retention": "durable",
  "subjects": {
    "kind": "storybook",
    "index": "storybook-static/index.json",
    "collector": "collector/index.mjs",
    "excludeTags": ["no-variance"]
  },
  "baselines": { "kind": "directory", "root": ".variance/baselines" },
  "fonts": ["ui-sans-serif/400/normal/sha256-case-system-stack"],
  "report": ".variance/run.json",
  "images": ".variance/images"
}
