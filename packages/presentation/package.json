{
  "name": "@variance-authority/presentation",
  "version": "0.4.1",
  "description": "Sense spacing, alignment, prominence and repetition inside one live interface, as evidence an agent can read.",
  "keywords": [
    "variance-authority",
    "layout",
    "spacing",
    "alignment",
    "accessibility",
    "agent",
    "ui-analysis"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/presentation",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/presentation"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "skills",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/dom": "workspace:^",
    "@variance-authority/react": "workspace:^",
    "@variance-authority/report": "workspace:^"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49 <2"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  }
}
