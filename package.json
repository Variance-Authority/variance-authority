{
  "name": "variance-authority",
  "description": "Composable evidence tools for software that changes.",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/sense/npm/*",
    "examples/*",
    "cases/*"
  ],
  "scripts": {
    "build": "tsc --build && node packages/sense/native/build.mjs && node tools/page-agents.mjs && node tools/tribunal-ui.mjs && node tools/tribunal-migrations.mjs",
    "check": "vitest run --config vitest.checks.config.ts",
    "clean": "tsc --build --clean",
    "lint": "oxlint",
    "measure": "vitest run --config vitest.measure.config.ts",
    "release:version": "changeset version && node tools/changelog-tidy.mjs",
    "release:publish": "changeset publish",
    "test": "vitest run && vitest run --config vitest.integration.config.mts && vitest run --config vitest.chromium.config.mts",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:chromium": "vitest run --config vitest.chromium.config.mts",
    "test:coverage": "vitest run --config tools/coverage.config.mts",
    "test:since": "variance index && VARIANCE_AUTHORITY_SINCE=${VARIANCE_AUTHORITY_SINCE:-} yarn test",
    "test:watch": "vitest",
    "unrun": "node tools/unrun.mjs",
    "surface": "node tools/surface.mjs",
    "documented": "node tools/documented.mjs",
    "typecheck": "tsc --build --force",
    "verify": "yarn lint && yarn check && yarn measure && yarn test",
    "verify:far": "variance index && VARIANCE_AUTHORITY_SINCE=${VARIANCE_AUTHORITY_SINCE:-} VARIANCE_AUTHORITY_AT_DISTANCE=3- yarn test",
    "verify:near": "oxlint && tsc --build && variance index && VARIANCE_AUTHORITY_SINCE=${VARIANCE_AUTHORITY_SINCE:-} VARIANCE_AUTHORITY_AT_DISTANCE=0-2 yarn test",
    "verify:rules": "yarn check"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@variance-authority/cli": "workspace:^",
    "@variance-authority/help": "workspace:^",
    "@vitest/coverage-v8": "^2.1.8",
    "backlog.md": "1.50.1",
    "ci-info": "^4.4.0",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "oxc-parser": "^0.144.0",
    "oxlint": "^1.77.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
