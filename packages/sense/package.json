{
  "name": "@variance-authority/sense",
  "version": "0.1.1",
  "description": "Which components and tests a source change reaches: test selection and impact analysis from a versioned index of a checkout.",
  "keywords": [
    "variance-authority",
    "test-selection",
    "impact-analysis",
    "dependency-graph",
    "static-analysis",
    "monorepo",
    "typescript"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/sense",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/sense"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./read": {
      "types": "./dist/read.d.ts",
      "default": "./dist/read.js"
    },
    "./taint": {
      "types": "./dist/taint/index.d.ts",
      "default": "./dist/taint/index.js"
    },
    "./instrument": {
      "types": "./dist/instrument/index.d.ts",
      "default": "./dist/instrument/index.js"
    },
    "./test-selection": {
      "types": "./dist/test-selection/index.d.ts",
      "default": "./dist/test-selection/index.js"
    },
    "./journal": {
      "types": "./dist/test-selection/journal.d.ts",
      "default": "./dist/test-selection/journal.js"
    },
    "./journey": {
      "types": "./dist/test-selection/journey.d.ts",
      "default": "./dist/test-selection/journey.js"
    },
    "./vitest": {
      "types": "./dist/test-selection/vitest.d.ts",
      "default": "./dist/test-selection/vitest.js"
    },
    "./jest": {
      "types": "./dist/test-selection/jest.d.ts",
      "default": "./dist/test-selection/jest.js"
    },
    "./jest-transform": {
      "types": "./dist/test-selection/jest-transform.d.ts",
      "default": "./dist/test-selection/jest-transform.js"
    },
    "./jest-reporter": {
      "types": "./dist/test-selection/jest-reporter.d.ts",
      "default": "./dist/test-selection/jest-reporter.js"
    },
    "./jest-setup": "./dist/test-selection/jest-setup.cjs",
    "./jest-globals": "./dist/test-selection/jest-globals.cjs"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg",
    "scripts/overhead.mjs"
  ],
  "scripts": {
    "build": "tsc --build",
    "storage": "node scripts/storage.mjs",
    "overhead": "node scripts/overhead.mjs",
    "records": "node scripts/records.mjs",
    "coverage": "node scripts/coverage.mjs",
    "native": "node scripts/native.mjs"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/wire": "workspace:^",
    "oxc-parser": "^0.144.0",
    "oxc-resolver": "^11.24.2",
    "picomatch": "^4.0.7"
  },
  "peerDependencies": {
    "vitest": "^2.1.9"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.5.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/picomatch": "^4.0.3",
    "jest": "^30.5.1"
  }
}
