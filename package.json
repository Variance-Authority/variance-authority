{
  "name": "variance-authority",
  "license": "MIT",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "examples/*",
    "cases/*"
  ],
  "scripts": {
    "build": "node tools/doc-examples.mjs && tsc --build && node tools/page-agents.mjs && node tools/tribunal-migrations.mjs",
    "check": "vitest run --config vitest.checks.config.ts",
    "clean": "tsc --build --clean",
    "lint": "oxlint",
    "release:version": "node tools/release-version.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node tools/doc-examples.mjs && tsc --build --force",
    "verify": "yarn lint && yarn check && yarn test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
