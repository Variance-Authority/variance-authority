{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "site"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "tribunal-storybook",
      "runtimeExecutable": "yarn",
      "runtimeArgs": [
        "workspace",
        "@variance-authority/tribunal",
        "storybook",
        "--no-open"
      ],
      "port": 6007
    }
  ]
}
