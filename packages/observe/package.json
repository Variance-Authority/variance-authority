{
  "name": "@variance-authority/observe",
  "version": "0.5.9",
  "description": "Compare render documents or rasters and receive one Variance Authority observation, whatever produced the images.",
  "keywords": [
    "variance-authority",
    "observation",
    "image-comparison",
    "integration"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/observe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/observe"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/png": "workspace:^",
    "@variance-authority/raster": "workspace:^"
  },
  "devDependencies": {
    "@variance-authority/remote": "workspace:^",
    "@variance-authority/store": "workspace:^",
    "@variance-authority/tribunal": "workspace:^",
    "pngjs": "^7.0.0"
  }
}
