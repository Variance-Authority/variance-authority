{
  "name": "@variance-authority/server",
  "version": "0.0.0-beta.1",
  "license": "MIT",
  "author": "Mechanic Garden",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/variance-authority/variance-authority.git",
    "directory": "packages/server"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/backend-sqlite.d.ts",
      "default": "./dist/backend-sqlite.js"
    },
    "./bin": {
      "types": "./dist/bin.d.ts",
      "default": "./dist/bin.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "variance-authority-server": "./dist/bin.js"
  },
  "files": [
    "dist",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/history": "workspace:^"
  }
}
