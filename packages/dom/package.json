{
  "name": "@variance-authority/dom",
  "version": "0.0.0-beta.1",
  "description": "Extract a Variance Authority capture from a mounted element, under jsdom or a browser, with CSS applicability pruning.",
  "keywords": [
    "variance-authority",
    "dom",
    "jsdom",
    "css",
    "capture",
    "serialization"
  ],
  "license": "MIT",
  "author": "Mechanic Garden",
  "homepage": "https://variance-authority.dev#packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/dom"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^"
  },
  "devDependencies": {
    "@variance-authority/react": "workspace:^",
    "jsdom": "^30.0.1",
    "react": "^19",
    "react-dom": "^19"
  }
}
