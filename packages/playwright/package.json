{
  "name": "@variance-authority/playwright",
  "version": "0.5.10",
  "description": "A persistent Playwright harness and renderer for Variance Authority: one browser per run, documents turned into rasters.",
  "keywords": [
    "variance-authority",
    "playwright",
    "chromium",
    "browser",
    "renderer"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/playwright",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/playwright"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engines": {
      "types": "./dist/engines.d.ts",
      "default": "./dist/engines.js"
    },
    "./agent": {
      "types": "./dist/agent.d.ts",
      "default": "./dist/agent.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "default": "./dist/renderer.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg",
    "scripts/host.mjs",
    "scripts/paint.mjs"
  ],
  "scripts": {
    "build": "tsc --build",
    "execute": "node scripts/execute.mjs",
    "host": "node scripts/host.mjs",
    "paint": "node scripts/paint.mjs"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/raster": "workspace:^",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@variance-authority/png": "workspace:^"
  }
}
