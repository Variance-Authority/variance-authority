{
  "name": "@variance-authority/unit-test",
  "version": "0.8.0",
  "description": "Capture a mounted DOM subject in a browserless Jest, Vitest or Rstest process, then render and observe it later.",
  "keywords": [
    "variance-authority",
    "visual-regression",
    "visual-testing",
    "vitest",
    "jest",
    "jsdom",
    "component-testing"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/unit-test",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/unit-test"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "default": "./dist/capture.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/dom": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@variance-authority/react": "workspace:^",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
