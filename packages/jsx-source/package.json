{
  "name": "@variance-authority/jsx-source",
  "version": "0.2.0",
  "description": "Carry the file and line that wrote a JSX element as far as the rendered DOM node.",
  "keywords": [
    "variance-authority",
    "jsx",
    "babel",
    "source-location",
    "react",
    "provenance"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/jsx-source",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/jsx-source"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime.d.ts",
      "default": "./dist/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-dev-runtime.d.ts",
      "default": "./dist/jsx-dev-runtime.js"
    },
    "./under": {
      "types": "./dist/under.d.ts",
      "default": "./dist/under.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./jest-resolver": "./jest-resolver.cjs"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "jest-resolver.cjs",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@variance-authority/react": "workspace:^",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
