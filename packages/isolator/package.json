{
  "name": "@variance-authority/isolator",
  "version": "0.19.0",
  "description": "Give every test, request or render its own copy of a module's state: a build transform turns module-level variables into per-session slots.",
  "keywords": [
    "variance-authority",
    "flaky-tests",
    "test-isolation",
    "shared-state",
    "module-state",
    "jest",
    "rspack"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/isolator",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/isolator"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./jest": {
      "types": "./dist/jest.d.ts",
      "default": "./dist/jest.js"
    },
    "./rspack": {
      "types": "./dist/rspack.d.ts",
      "default": "./dist/rspack.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@variance-authority/ioc": "workspace:^",
    "@variance-authority/jest-transformer": "workspace:^",
    "magic-string": "^0.30.21",
    "oxc-parser": "^0.144.0",
    "picomatch": "^4.0.7"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rspack/core": "^2.2.6",
    "@swc/jest": "^0.2.39",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.14",
    "jest": "^30.5.1",
    "react": "^19.2.8",
    "react-server-dom-parcel": "^19.3.1"
  }
}
