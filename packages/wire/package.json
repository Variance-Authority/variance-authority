{
  "name": "@variance-authority/wire",
  "version": "0.2.0",
  "description": "The address a process under test answers on, so what it reports reaches the run that started it and nothing is written down.",
  "keywords": [
    "variance-authority",
    "flaky-tests",
    "e2e",
    "testing",
    "instrumentation",
    "observability"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/wire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/wire"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./listen": {
      "types": "./dist/listen.d.ts",
      "default": "./dist/listen.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  }
}
