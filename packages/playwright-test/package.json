{
  "name": "@variance-authority/playwright-test",
  "version": "0.10.0",
  "description": "Add a source-aware visual observation to a Playwright test that already knows how to reach the state.",
  "keywords": [
    "variance-authority",
    "visual-regression",
    "visual-testing",
    "playwright",
    "screenshot-testing",
    "e2e",
    "rstest"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/playwright-test",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/playwright-test"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22.15"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./reporter": {
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./rstest": {
      "types": "./dist/rstest.d.ts",
      "default": "./dist/rstest.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/dom": "workspace:^",
    "@variance-authority/event": "workspace:^",
    "@variance-authority/observe": "workspace:^",
    "@variance-authority/playwright": "workspace:^",
    "@variance-authority/png": "workspace:*",
    "@variance-authority/raster": "workspace:^",
    "@variance-authority/react": "workspace:^",
    "@variance-authority/sense": "workspace:^",
    "@variance-authority/store": "workspace:^",
    "@variance-authority/vantage": "workspace:^",
    "@variance-authority/wire": "workspace:^"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49 <2"
  }
}
