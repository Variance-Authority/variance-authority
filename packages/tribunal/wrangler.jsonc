{
  // The deployment descriptor for `@variance-authority/tribunal`: a Worker, a D1
  // database for rows, and an R2 bucket for bytes.
  //
  // Copy it, then fill `database_id` from `wrangler d1 create`. The two secrets
  // are not here and must never be — see the README for how they are set.
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "variance-tribunal",
  "main": "dist/worker-entry.js",
  "compatibility_date": "2026-08-05",

  // Rows: builds, verdicts, decisions, baselines metadata, history observations.
  // `migrations_dir` holds one file per schema step, generated from `schema.ts`
  // by `tools/tribunal-migrations.mjs` and gated by `migrations.test.ts` — a
  // hand-edited migration is a table the tests do not know about. Steps rather
  // than one file because `wrangler` records what it has applied: a database
  // deployed before a table existed gets the step that adds it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "variance-tribunal",
      "database_id": "PLACEHOLDER — replace with the id `wrangler d1 create` prints",
      "migrations_dir": "migrations"
    }
  ],

  // Bytes: baseline and candidate images. Never a row, and never anything a
  // query has to scan.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "variance-tribunal"
    }
  ],

  "vars": {
    // Scopes every row and object. One deployment, one project — spec 0014 is
    // where the reason that has to change before a second tenant is written down.
    "PROJECT": "default"
  },

  "observability": {
    "enabled": true
  }
}
