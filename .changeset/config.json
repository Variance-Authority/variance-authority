{
  "$schema": "https://unpkg.com/@changesets/config@3.0.0/schema.json",
  "changelog": "@changesets/changelog-git",
  "commit": false,
  "access": "public",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "fixed": [["@variance-authority/*"]],
  "linked": [],
  "privatePackages": false,
  "ignore": [],
  "changedFilePatterns": [
    "**",
    "!**/*.test.*",
    "!**/*.check.*",
    "!**/*.measure.*",
    "!**/*_tests.rs",
    "!test/**",
    "!**/__fixtures__/**",
    "!README.md",
    "!CHANGELOG.md"
  ]
}
