{
  "name": "@variance-authority/store",
  "version": "0.3.0",
  "description": "Variance Authority baselines on a filesystem, in a plain directory or through git-LFS.",
  "keywords": [
    "variance-authority",
    "baselines",
    "snapshots",
    "git-lfs",
    "storage"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/store",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/store"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    "./durable": {
      "types": "./dist/durable.d.ts",
      "default": "./dist/durable.js"
    },
    "./lfs": {
      "types": "./dist/lfs.d.ts",
      "default": "./dist/lfs.js"
    },
    "./share": {
      "types": "./dist/share.d.ts",
      "default": "./dist/share.js"
    },
    "./changelog": {
      "types": "./dist/changelog.d.ts",
      "default": "./dist/changelog.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/raster": "workspace:^",
    "@variance-authority/report": "workspace:^"
  }
}
