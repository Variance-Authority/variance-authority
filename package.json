{
  "name": "variance-authority",
  "private": true,
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*",
    "examples/*",
    "cases/*"
  ],
  "scripts": {
    "build": "node tools/doc-examples.mjs && tsc --build",
    "clean": "tsc --build --clean",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "node tools/doc-examples.mjs && tsc --build --force"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jsdom": "^30.0.1",
    "oxlint": "^1.77.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"
  }
}
