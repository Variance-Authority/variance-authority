{
  "name": "@variance-authority/storybook-collector",
  "version": "0.5.3",
  "description": "Turn a built or already-served Storybook into Variance Authority subjects.",
  "keywords": [
    "variance-authority",
    "visual-regression",
    "visual-testing",
    "storybook",
    "component-testing",
    "stories"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/storybook-collector",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/storybook-collector"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22.15"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/dom": "workspace:^",
    "@variance-authority/playwright": "workspace:^",
    "@variance-authority/react": "workspace:^",
    "@variance-authority/sense": "workspace:^",
    "@variance-authority/storybook": "workspace:^"
  }
}
