{
  "name": "@variance-authority/raster",
  "version": "0.5.3",
  "description": "Pixel-tier contracts for Variance Authority: what a renderer and a store promise, and which policy a comparison ran under.",
  "keywords": [
    "variance-authority",
    "raster",
    "renderer",
    "comparison-policy",
    "contracts"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/raster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/raster"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./difference": {
      "types": "./dist/difference/index.d.ts",
      "default": "./dist/difference/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build",
    "simd": "node scripts/simd.mjs"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^"
  }
}
