{
  "name": "@variance-authority/case-storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6199 --no-open --quiet",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "build-storybook:a11y": "storybook build -c .storybook-a11y -o storybook-a11y --quiet",
    "variance": "node ../../packages/cli/dist/bin.js",
    "build-storybook:changed": "VITE_CASE_MUTATION=wide-button storybook build -o storybook-changed --quiet",
    "bench": "node scripts/bench.mjs",
    "bench:switch": "node scripts/switch-bench.mjs",
    "build-storybook:isolated": "storybook build -c .storybook-isolated -o storybook-isolated --quiet"
  },
  "dependencies": {
    "@variance-authority/storybook-collector": "workspace:^",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@variance-authority/cli": "workspace:^",
    "@variance-authority/core": "workspace:^",
    "@variance-authority/dom": "workspace:^",
    "@variance-authority/isolator": "workspace:^",
    "@variance-authority/jsx-source": "workspace:^",
    "@variance-authority/playwright": "workspace:^",
    "@variance-authority/react": "workspace:^",
    "@variance-authority/storybook": "workspace:^",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "storybook": "^10.6.5",
    "vite": "^8.3.5"
  }
}
