{
  "name": "@variance-authority/png",
  "version": "0.5.3",
  "description": "Decode, compare and diff PNGs without a browser: two buffers in, a mask out.",
  "keywords": [
    "variance-authority",
    "png",
    "image-diff",
    "image-comparison",
    "pixelmatch",
    "pixel-diff"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/png",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/png"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./difference": {
      "types": "./dist/difference.d.ts",
      "default": "./dist/difference.js"
    },
    "./mask": {
      "types": "./dist/mask.d.ts",
      "default": "./dist/mask.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/raster": "workspace:^",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
