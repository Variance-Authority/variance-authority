{
  "name": "@variance-authority/vantage",
  "version": "0.1.1",
  "description": "Hold what a running test suite is saying in a process an agent can ask, so a test in flight is something to look at rather than something to wait for.",
  "keywords": [
    "variance-authority",
    "flaky-tests",
    "e2e",
    "testing",
    "instrumentation",
    "observability",
    "mcp",
    "agent"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev#packages",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/vantage"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attach": {
      "types": "./dist/attach.d.ts",
      "default": "./dist/attach.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/event": "workspace:^",
    "@variance-authority/wire": "workspace:^"
  }
}
