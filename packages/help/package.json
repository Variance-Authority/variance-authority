{
  "name": "@variance-authority/help",
  "version": "0.2.0",
  "description": "Find the public name, signature, documentation, consumers and call sites of an exported TypeScript workspace symbol, over MCP.",
  "keywords": [
    "variance-authority",
    "mcp",
    "model-context-protocol",
    "monorepo",
    "typescript",
    "api-docs",
    "code-search"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/help",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/help"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "variance-authority-help": "./dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "mark.svg",
    "skill"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@variance-authority/mcp": "workspace:^",
    "@variance-authority/package": "workspace:^"
  }
}
