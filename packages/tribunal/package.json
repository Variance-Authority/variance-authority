{
  "name": "@variance-authority/tribunal",
  "version": "0.21.0",
  "description": "A self-hosted review service for Variance Authority baselines, history and per-subject decisions.",
  "keywords": [
    "variance-authority",
    "visual-regression",
    "visual-testing",
    "review",
    "approval",
    "self-hosted"
  ],
  "license": "MIT",
  "author": "Machine Garden",
  "homepage": "https://variance-authority.dev/reference/packages/tribunal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Variance-Authority/variance-authority.git",
    "directory": "packages/tribunal"
  },
  "bugs": "https://github.com/Variance-Authority/variance-authority/issues",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "default": "./dist/history.js"
    },
    "./review": {
      "types": "./dist/review.d.ts",
      "default": "./dist/review.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./worker-entry": {
      "types": "./dist/worker-entry.d.ts",
      "default": "./dist/worker-entry.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./fonts.css": "./fonts/fonts.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "variance-authority-tribunal": "./dist/node/bin.js",
    "variance-authority-tribunal-provision": "./dist/provision/bin.js"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "fonts",
    "mark.svg",
    "migrations",
    "wrangler.jsonc"
  ],
  "scripts": {
    "build": "tsc --build",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "storybook": "storybook dev -p 6007",
    "stories:record": "node stories/record.mjs"
  },
  "dependencies": {
    "@variance-authority/core": "workspace:^",
    "@variance-authority/history": "workspace:^",
    "@variance-authority/png": "workspace:^",
    "@variance-authority/raster": "workspace:^",
    "@variance-authority/report": "workspace:^",
    "@variance-authority/server": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@storybook/react-vite": "^9.1.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@variance-authority/jsx-source": "workspace:^",
    "@variance-authority/remote": "workspace:^",
    "@variance-authority/sense": "workspace:^",
    "@variance-authority/storybook-collector": "workspace:^",
    "pngjs": "^7.0.0",
    "react": "^19",
    "react-dom": "^19",
    "storybook": "^9.1.13",
    "vite": "^6.0.0"
  }
}
