{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./.tsbuildinfo",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.measure.ts"
  ],
  "references": [
    {
      "path": "../core"
    },
    {
      "path": "../dom"
    },
    {
      "path": "../observe"
    },
    {
      "path": "../playwright"
    },
    {
      "path": "../raster"
    },
    {
      "path": "../react"
    },
    {
      "path": "../store"
    },
    {
      "path": "../unit-test"
    }
  ]
}
